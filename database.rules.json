{
  "rules": {
    "trioRooms": {
      "$room": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('players').child(auth.uid).exists()) || (data.exists() && !newData.exists() && data.child('host').val() === auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || data.parent().numChildren() < 3)",
            ".validate": "newData.hasChildren(['name','joined']) && newData.child('name').isString() && newData.child('name').val().length <= 18 && newData.child('joined').isNumber()"
          }
        },
        "game": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          "clues": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('phase').val() === 'clues' && !data.exists()"
            }
          },
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('phase').val() === 'vote' && !data.exists()"
            }
          },
          "prompts": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('phase').val() === 'prompts' && !data.exists()"
            }
          },
          "drawings": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('phase').val() === 'draw' && !data.exists()",
              ".validate": "newData.isString() && newData.val().length < 120000"
            }
          },
          "guesses": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('phase').val() === 'guess' && !data.exists()"
            }
          },
          "used": {
            "$word": {
              ".write": "auth != null && data.parent().parent().child('order').child(data.parent().parent().child('turn').val()).val() === auth.uid && !data.exists()"
            }
          },
          "lastWord": {
            ".write": "auth != null && data.parent().child('order').child(data.parent().child('turn').val()).val() === auth.uid"
          },
          "turn": {
            ".write": "auth != null && data.parent().child('order').child(data.val()).val() === auth.uid"
          },
          "syllable": {
            ".write": "auth != null && data.parent().parent().child('players').child(auth.uid).exists()"
          },
          "deadline": {
            ".write": "auth != null && data.parent().parent().child('players').child(auth.uid).exists()"
          },
          "round": {
            ".write": "auth != null && data.parent().parent().child('players').child(auth.uid).exists()"
          }
        },
        "scores": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        }
      }
    },
    "trioSecrets": {
      "$room": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('trioRooms').child($room).child('host').val() === auth.uid"
        }
      }
    },
    "trioHostSecrets": {
      "$room": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && root.child('trioRooms').child($room).child('host').val() === auth.uid",
          ".write": "auth != null && auth.uid === $uid && root.child('trioRooms').child($room).child('host').val() === auth.uid"
        }
      }
    }
  }
}